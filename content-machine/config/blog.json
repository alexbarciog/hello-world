{
  "site": "https://intentsly.com",
  "blog_path": "/blog",
  "author": "Alex Barciog",
  "author_title": "CEO & Founder, Intentsly",
  "autopublish": true,
  "max_posts_per_week": 21,
  "publish_days": [
    "Mon",
