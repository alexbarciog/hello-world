{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "hello-world",
  "compatibility_date": "2026-10-06",
  // Only runs for run_worker_first paths: the Claude connector (/mcp) and
  // real 404s for unknown free guides (/free/*). See worker/index.ts.
  "main": "./worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/*", "/.well-known/oauth-protected-resource", "/.well-known/oauth-protected-resource/*", "/free/*"]
  }
}
